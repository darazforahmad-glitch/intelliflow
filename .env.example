# =============================================================================
# IntelliFlow environment configuration (twelve-factor: all config via env vars)
# Copy to .env for local development. NEVER commit real secrets.
# =============================================================================

# --- Runtime -----------------------------------------------------------------
ENVIRONMENT=development            # development | staging | production
LOG_LEVEL=INFO
API_PUBLIC_URL=http://localhost:8000
FRONTEND_URL=http://localhost:3000
CORS_ORIGINS=http://localhost:3000

# --- Security (generate with: python manage.py generate_keys) ---------------
# JWT signing key for session tokens.
SECRET_KEY=change-me-dev-only-secret-key-at-least-32-chars
# AES-256-GCM key ring for tokens at rest: "kid:base64key[,kid:base64key]".
# The first key encrypts; all keys can decrypt (supports rotation).
ENCRYPTION_KEYS=dev1:ZGV2LW9ubHktZW5jcnlwdGlvbi1rZXktMzItYnl0ZXM=

# --- Data services -------------------------------------------------------------
DATABASE_URL=postgresql://intelliflow:intelliflow@localhost:5432/intelliflow
REDIS_URL=redis://localhost:6379/0
# Run Celery tasks inline (no worker needed). Handy for demos and tests.
CELERY_TASK_ALWAYS_EAGER=false

# --- LLM provider (behind the provider-agnostic LLMClient wrapper) -----------
# fake      -> FakeLLMClient: deterministic, offline, zero cost (default)
# anthropic -> Claude via the official Anthropic SDK (needs ANTHROPIC_API_KEY)
LLM_PROVIDER=fake
LLM_MODEL=claude-opus-5-5
ANTHROPIC_API_KEY=

# --- WhatsApp Cloud API (Meta Graph API) --------------------------------------
WHATSAPP_APP_SECRET=dev-whatsapp-app-secret
WHATSAPP_VERIFY_TOKEN=dev-verify-token
WHATSAPP_GRAPH_API_VERSION=v23.0

# --- Google OAuth 2.0 (Gmail + Sheets). Leave empty to use sandbox connections.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- Notifications ---------------------------------------------------------------
# console -> e-mails go to the outbox table + logs (dev); smtp -> real delivery
EMAIL_BACKEND=console
EMAIL_FROM=IntelliFlow <no-reply@intelliflow.local>
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
# Web Push VAPID keys (generate with: python manage.py generate_vapid)
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@intelliflow.local

# --- Observability ---------------------------------------------------------------
SENTRY_DSN=

# --- Frontend (Next.js) ------------------------------------------------------------
NEXT_PUBLIC_API_URL=http://localhost:8000

# --- Docker Compose only (read by docker-compose.yml) -------------------------------
# Load the demo workspace on first start (demo@intelliflow.pk / Demo12345).
SEED_DEMO=true
# Host ports for the web app and the API; change them if 3000 or 8000 is already taken.
WEB_PORT=3000
API_PORT=8000
