{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://intelliflow.app/schemas/workflow.schema.json",
  "title": "IntelliFlow workflow definition (REQ-AB-1, REQ-AB-2)",
  "type": "object",
  "required": [
    "schema_version",
    "name",
    "trigger",
    "blocks"
  ],
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": 1
    },
    "name": {
      "type": "string",
      "minLength": 2,
      "maxLength": 120
    },
    "description": {
      "type": "string",
      "maxLength": 500
    },
    "trigger": {
      "$ref": "#/$defs/trigger"
    },
    "blocks": {
      "type": "array",
      "minItems": 1,
      "maxItems": 25,
      "items": {
        "$ref": "#/$defs/block"
      }
    },
    "settings": {
      "$ref": "#/$defs/settings"
    }
  },
  "$defs": {
    "key": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_]{1,39}$"
    },
    "template_string": {
      "type": "string",
      "maxLength": 4000
    },
    "expression": {
      "type": "string",
      "minLength": 1,
      "maxLength": 300
    },
    "settings": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "estimated_minutes_saved": {
          "type": "number",
          "minimum": 0,
          "maximum": 600
        },
        "approval_threshold": {
          "type": "number",
          "minimum": 0
        },
        "language": {
          "enum": [
            "en",
            "ur",
            "roman-ur"
          ]
        },
        "max_messages_per_hour": {
          "type": "integer",
          "minimum": 1,
          "maximum": 1000
        },
        "approval_reminder_minutes": {
          "type": "integer",
          "minimum": 5,
          "maximum": 10080
        },
        "approval_timeout_minutes": {
          "type": "integer",
          "minimum": 10,
          "maximum": 20160
        }
      }
    },
    "trigger": {
      "type": "object",
      "required": [
        "type"
      ],
      "additionalProperties": false,
      "properties": {
        "type": {
          "enum": [
            "whatsapp.message_received",
            "gmail.message_received",
            "webform.submitted",
            "schedule.daily",
            "schedule.interval",
            "manual"
          ]
        },
        "filters": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "message_types": {
              "type": "array",
              "items": {
                "enum": [
                  "text",
                  "image",
                  "document",
                  "audio",
                  "interactive",
                  "button"
                ]
              }
            },
            "from_contains": {
              "type": "string",
              "maxLength": 120
            },
            "subject_contains": {
              "type": "string",
              "maxLength": 120
            },
            "form_name": {
              "type": "string",
              "maxLength": 120
            }
          }
        },
        "at": {
          "type": "string",
          "pattern": "^([01][0-9]|2[0-3]):[0-5][0-9]$"
        },
        "every_minutes": {
          "type": "integer",
          "minimum": 5,
          "maximum": 1440
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "type": {
                "const": "schedule.daily"
              }
            }
          },
          "then": {
            "required": [
              "at"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "schedule.interval"
              }
            }
          },
          "then": {
            "required": [
              "every_minutes"
            ]
          }
        }
      ]
    },
    "block": {
      "type": "object",
      "required": [
        "key",
        "type"
      ],
      "properties": {
        "key": {
          "$ref": "#/$defs/key"
        },
        "type": {
          "enum": [
            "ai.classify",
            "ai.extract",
            "ai.draft_reply",
            "ai.summarize",
            "condition",
            "approval",
            "action"
          ]
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "type": {
                "const": "ai.classify"
              }
            },
            "required": [
              "type"
            ]
          },
          "then": {
            "$ref": "#/$defs/ai_classify"
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "ai.extract"
              }
            },
            "required": [
              "type"
            ]
          },
          "then": {
            "$ref": "#/$defs/ai_extract"
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "ai.draft_reply"
              }
            },
            "required": [
              "type"
            ]
          },
          "then": {
            "$ref": "#/$defs/ai_draft_reply"
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "ai.summarize"
              }
            },
            "required": [
              "type"
            ]
          },
          "then": {
            "$ref": "#/$defs/ai_summarize"
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "condition"
              }
            },
            "required": [
              "type"
            ]
          },
          "then": {
            "$ref": "#/$defs/condition"
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "approval"
              }
            },
            "required": [
              "type"
            ]
          },
          "then": {
            "$ref": "#/$defs/approval"
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "action"
              }
            },
            "required": [
              "type"
            ]
          },
          "then": {
            "$ref": "#/$defs/action"
          }
        }
      ]
    },
    "ai_classify": {
      "type": "object",
      "required": [
        "key",
        "type",
        "input",
        "labels"
      ],
      "additionalProperties": false,
      "properties": {
        "key": {
          "$ref": "#/$defs/key"
        },
        "type": {
          "const": "ai.classify"
        },
        "title": {
          "type": "string",
          "maxLength": 120
        },
        "description": {
          "type": "string",
          "maxLength": 500
        },
        "input": {
          "$ref": "#/$defs/template_string"
        },
        "labels": {
          "type": "array",
          "minItems": 2,
          "maxItems": 10,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/key"
          }
        },
        "instructions": {
          "type": "string",
          "maxLength": 1000
        }
      }
    },
    "ai_extract": {
      "type": "object",
      "required": [
        "key",
        "type",
        "input",
        "fields"
      ],
      "additionalProperties": false,
      "properties": {
        "key": {
          "$ref": "#/$defs/key"
        },
        "type": {
          "const": "ai.extract"
        },
        "title": {
          "type": "string",
          "maxLength": 120
        },
        "description": {
          "type": "string",
          "maxLength": 500
        },
        "input": {
          "$ref": "#/$defs/template_string"
        },
        "instructions": {
          "type": "string",
          "maxLength": 1000
        },
        "fields": {
          "type": "array",
          "minItems": 1,
          "maxItems": 20,
          "items": {
            "type": "object",
            "required": [
              "name",
              "type"
            ],
            "additionalProperties": false,
            "properties": {
              "name": {
                "$ref": "#/$defs/key"
              },
              "type": {
                "enum": [
                  "string",
                  "number",
                  "integer",
                  "boolean"
                ]
              },
              "description": {
                "type": "string",
                "maxLength": 200
              },
              "required": {
                "type": "boolean"
              }
            }
          }
        }
      }
    },
    "ai_draft_reply": {
      "type": "object",
      "required": [
        "key",
        "type",
        "instructions"
      ],
      "additionalProperties": false,
      "properties": {
        "key": {
          "$ref": "#/$defs/key"
        },
        "type": {
          "const": "ai.draft_reply"
        },
        "title": {
          "type": "string",
          "maxLength": 120
        },
        "description": {
          "type": "string",
          "maxLength": 500
        },
        "input": {
          "$ref": "#/$defs/template_string"
        },
        "instructions": {
          "type": "string",
          "maxLength": 1000
        },
        "language": {
          "enum": [
            "auto",
            "en",
            "ur",
            "roman-ur"
          ]
        },
        "facts": {
          "type": "object",
          "additionalProperties": {
            "$ref": "#/$defs/template_string"
          }
        }
      }
    },
    "ai_summarize": {
      "type": "object",
      "required": [
        "key",
        "type",
        "input",
        "instructions"
      ],
      "additionalProperties": false,
      "properties": {
        "key": {
          "$ref": "#/$defs/key"
        },
        "type": {
          "const": "ai.summarize"
        },
        "title": {
          "type": "string",
          "maxLength": 120
        },
        "description": {
          "type": "string",
          "maxLength": 500
        },
        "input": {
          "$ref": "#/$defs/template_string"
        },
        "instructions": {
          "type": "string",
          "maxLength": 1000
        }
      }
    },
    "condition": {
      "type": "object",
      "required": [
        "key",
        "type",
        "if"
      ],
      "additionalProperties": false,
      "properties": {
        "key": {
          "$ref": "#/$defs/key"
        },
        "type": {
          "const": "condition"
        },
        "title": {
          "type": "string",
          "maxLength": 120
        },
        "description": {
          "type": "string",
          "maxLength": 500
        },
        "if": {
          "$ref": "#/$defs/expression"
        },
        "else": {
          "enum": [
            "stop",
            "continue"
          ]
        }
      }
    },
    "proposed_action": {
      "type": "object",
      "required": [
        "connector",
        "operation",
        "params"
      ],
      "additionalProperties": false,
      "properties": {
        "connector": {
          "enum": [
            "whatsapp",
            "gmail",
            "google_sheets"
          ]
        },
        "operation": {
          "type": "string",
          "pattern": "^[a-z_]{3,40}$"
        },
        "params": {
          "type": "object"
        }
      }
    },
    "approval": {
      "type": "object",
      "required": [
        "key",
        "type",
        "kind"
      ],
      "additionalProperties": false,
      "properties": {
        "key": {
          "$ref": "#/$defs/key"
        },
        "type": {
          "const": "approval"
        },
        "title": {
          "type": "string",
          "maxLength": 120
        },
        "description": {
          "type": "string",
          "maxLength": 500
        },
        "kind": {
          "enum": [
            "customer_message",
            "money",
            "review"
          ]
        },
        "when": {
          "$ref": "#/$defs/expression"
        },
        "message": {
          "$ref": "#/$defs/template_string"
        },
        "show": {
          "type": "array",
          "maxItems": 10,
          "items": {
            "type": "string",
            "maxLength": 80
          }
        },
        "proposed_action": {
          "$ref": "#/$defs/proposed_action"
        },
        "editable": {
          "type": "array",
          "maxItems": 10,
          "items": {
            "type": "string",
            "maxLength": 40
          }
        }
      }
    },
    "action": {
      "type": "object",
      "required": [
        "key",
        "type",
        "connector",
        "operation",
        "params"
      ],
      "additionalProperties": false,
      "properties": {
        "key": {
          "$ref": "#/$defs/key"
        },
        "type": {
          "const": "action"
        },
        "title": {
          "type": "string",
          "maxLength": 120
        },
        "description": {
          "type": "string",
          "maxLength": 500
        },
        "connector": {
          "enum": [
            "whatsapp",
            "gmail",
            "google_sheets"
          ]
        },
        "operation": {
          "type": "string",
          "pattern": "^[a-z_]{3,40}$"
        },
        "params": {
          "type": "object"
        }
      }
    }
  }
}
