{
  "name": "intelliflow-web",
  "version": "0.5.0",
  "private": true,
  "description": "IntelliFlow web app and approvals PWA (Next.js)",
  "scripts": {
    "dev": "node scripts/build-sw.mjs && next dev",
    "build": "node scripts/build-sw.mjs && next build",
    "start": "next start",
    "build:sw": "node scripts/build-sw.mjs",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test:e2e": "playwright test --trace off"
  },
  "dependencies": {
    "@tanstack/react-query": "5.108.4",
    "@xyflow/react": "12.12.1",
    "clsx": "2.1.1",
    "lucide-react": "1.82.0",
    "next": "16.4.6",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "recharts": "3.11.2",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@tailwindcss/postcss": "4.3.5",
    "@types/node": "22.20.7",
    "@types/react": "19.3.3",
    "@types/react-dom": "19.3.0",
    "esbuild": "0.28.2",
    "eslint": "9.39.5",
    "eslint-config-next": "16.4.6",
    "postcss": "8.5.34",
    "prettier": "3.10.1",
    "tailwindcss": "4.3.5",
    "typescript": "5.9.3",
    "workbox-expiration": "7.4.1",
    "workbox-precaching": "7.4.1",
    "workbox-routing": "7.4.1",
    "workbox-strategies": "7.4.1"
  },
  "engines": {
    "node": ">=20.9"
  }
}
